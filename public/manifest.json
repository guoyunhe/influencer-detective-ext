{
  "manifest_version": 3,
  "name": "Influencer Detective",
  "version": "1.0.0",
  "description": "Detect influencer info for YouTube and Bilibili videos via the Influencer Detective API.",
  "background": {
    "service_worker": "background.js",
    "scripts": ["api.js", "background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Influencer Detective",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.bilibili.com/*",
    "https://*.x.com/*",
    "https://*.twitter.com/*",
    "https://*.tiktok.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*", "https://youtu.be/*", "https://*.bilibili.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "influencer-detective@influencer-detective.local",
      "strict_min_version": "115.0"
    }
  }
}
